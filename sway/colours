set $bg       #000000
set $fg       #ffffff
set $accent   #d79921
set $accentd  #fe8019
set $accent2  #d79921
set $accent2d #962338
set $color0   #282828
set $color1   #cc241d
set $color2   #98971a
set $color3   #d79921
set $color4   #458588
set $color5   #b16286
set $color6   #689d6a
set $color7   #a89984
set $color8   #928374
set $color9   #fb4934
set $color10  #b8bb26
set $color11  #fabd2f
set $color12  #83a598
set $color13  #d3869b
set $color14  #8ec07c
set $color15  #ebdbb2

# class                  border    backgr.   text     indicator  child_border
client.focused           $accent   $accent   $bg      $accent2   $accent
client.focused_inactive  $color0   $color0   $fg      $color0    $color8
client.unfocused         $bg       $bg       $fg      $color0    $color0
client.urgent            $accent2d $accent2d $bg      $accent2   $accent2

bar {
    position bottom
    status_command i3status
    colors {
        background         $bg
        statusline         $fg
        separator          $color8
        focused_workspace  $accent  $accent  $bg
        active_workspace   $color0  $color0  $fg
        inactive_workspace $color0  $color0  $color8
        urgent_workspace   $accent2 $accent2 $bg
    }
}
