set $bg       #060906
set $fg       #e6f2e6
set $accent   #55eb34
set $accentd  #3bb01f
set $accent2  #55eb34
set $accent2d #1b5510
set $color0   #060906
set $color1   #ff5f56
set $color2   #55eb34
set $color3   #e3c565
set $color4   #4fa3e0
set $color5   #a78bda
set $color6   #3fd7c4
set $color7   #c8d8c8
set $color8   #4d7347
set $color9   #ff7b72
set $color10  #8ff56f
set $color11  #f0d878
set $color12  #7ab8f0
set $color13  #c4a8ee
set $color14  #6fe8d8
set $color15  #ffffff

# class                  border    backgr.   text     indicator  child_border
client.focused           $accent   $accent   $bg      $accent2   $accent
client.focused_inactive  $color0   $color0   $fg      $color0    $color8
client.unfocused         $bg       $bg       $fg      $color0    $color0
client.urgent            $accent2d $accent2d $bg      $accent2   $accent2

bar {
    position bottom
    status_command i3status
    font pango:Iosevka 11
    colors {
        background         $bg
        statusline         $fg
        separator          $color8
        focused_workspace  $accent  $accent  $bg
        active_workspace   $color0  $color0  $fg
        inactive_workspace $color0  $color0  $fg
        urgent_workspace   $accent2 $accent2 $bg
    }
}
