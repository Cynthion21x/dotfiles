set $bg       #1a1b26
set $fg       #ffffff
set $accent   #e0af68
set $accentd  #c9a260
set $accent2  #e0af68
set $accent2d #9d7cd8
set $color0   #1a1b26
set $color1   #f7768e
set $color2   #9ece6a
set $color3   #e0af68
set $color4   #7aa2f7
set $color5   #bb9af7
set $color6   #7dcfff
set $color7   #c0caf5
set $color8   #414868
set $color9   #ff899d
set $color10  #b9f27c
set $color11  #ff9e64
set $color12  #7da6ff
set $color13  #c0a7f7
set $color14  #a4daff
set $color15  #d5d9f5

# class                  border    backgr.   text     indicator  child_border
client.focused           $accent   $accent   $bg      $accent2   $accent
client.focused_inactive  $color0   $color0   $fg      $color0    $color8
client.unfocused         $bg       $bg       $fg      $color0    $color0
client.urgent            $accent2d $accent2d $bg      $accent2   $accent2

bar {
    position bottom
    status_command i3status
    colors {
        background         $bg
        statusline         $fg
        separator          $color8
        focused_workspace  $accent  $accent  $bg
        active_workspace   $color0  $color0  $fg
        inactive_workspace $color0  $color0  $fg
        urgent_workspace   $accent2 $accent2 $bg
    }
}
